cionadas (puedes cambiar los números del 1 al 100)\n","# Según tu plan: 1 (lata/botella), 5 (juguete), 12 (herramienta), 25 (fruta), 40 (pieza industrial)\n","SELECTED_CLASSES = [1, 5, 12, 25, 40]\n","TRAIN_RATIO = 0.7  # 70% entrenamiento, 30% prueba"]},{"cell_type":"code","execution_count":4,"id":"b70395dc","metadata":{"execution":{"iopub.execute_input":"2026-10-20T19:11:40.689791Z","iopub.status.busy":"2026-10-20T19:11:40.689427Z","iopub.status.idle":"2026-10-20T19:11:45.708801Z","shell.execute_reply":"2026-10-20T19:11:45.707819Z"},"papermill":{"duration":5.023931,"end_time":"2026-10-20T19:11:45.71071+00:00","exception":false,"start_time":"2026-10-20T19:11:40.686779+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["📥 Descargando COIL-100... (aprox. 133 MB, puede tardar un momento)\n","✅ Descarga completada.\n","📂 Extrayendo dataset...\n","✅ Extracción completada.\n","🗂️ Organizando dataset en estructura train/test...\n","  ➔ clase_1: 0 train, 0 test\n","  ➔ clase_5: 0 train, 0 test\n","  ➔ clase_12: 0 train, 0 test\n","  ➔ clase_25: 0 train, 0 test\n","  ➔ clase_40: 0 train, 0 test\n","✅ Organización completada. Revisa la carpeta 'data/' y su 'README.md'.\n","\n","🚀 ¡Listo! El dataset está preparado para el pipeline.\n"]}],"source":["# =================================================\n","\n","def download_dataset():\n","    if not os.path.exists(ZIP_FILENAME):\n","        print(\"📥 Descargando COIL-100... (aprox. 133 MB, puede tardar un momento)\")\n","        try:\n","            req = urllib.request.Request(DATASET_URL, headers={'User-Agent': 'Mozilla/5.0'})\n","            with urllib.request.urlopen(req) as response, open(ZIP_FILENAME, 'wb') as out_file:\n","                shutil.copyfileobj(response, out_file)\n","            print(\"✅ Descarga completada.\")\n","        except Exception as e:\n","            print(f\"❌ Error en la descarga: {e}\")\n","            print(\"💡 Alternativa: Descarga manualmente el ZIP desde Kaggle y colócalo en esta carpeta.\")\n","            return False\n","    else:\n","        print(\"ℹ️ El archivo ZIP ya existe. Omitiendo descarga.\")\n","    return True\n","\n","def extract_dataset():\n","    if not os.path.exists(EXTRACT_FOLDER):\n","        print(\"📂 Extrayendo dataset...\")\n","        with zipfile.ZipFile(ZIP_FILENAME, 'r') as zip_ref:\n","            zip_ref.extractall(EXTRACT_FOLDER)\n","        print(\"✅ Extracción completada.\")\n","    else:\n","        print(\"ℹ️ La carpeta extraída ya existe. Omitiendo extracción.\")\n","\n","def organize_dataset():\n","    print(\"🗂️ Organizando dataset en estructura train/test...\")\n","    \n","    train_dir = os.path.join(TARGET_DIR, \"train\")\n","    test_dir = os.path.join(TARGET_DIR, \"test\")\n","    os.makedirs(train_dir, exist_ok=True)\n","    os.makedirs(test_dir, exist_ok=True)\n","    \n","    for obj_id in SELECTED_CLASSES:\n","        class_name = f\"clase_{obj_id}\"\n","        os.makedirs(os.path.join(train_dir, class_name), exist_ok=True)\n","        os.makedirs(os.path.join(test_dir, class_name), exist_ok=True)\n","        \n","        # COIL-100 tiene 72 imágenes por objeto: objX_Y.png (Y va de 0 a 355, de 5 en 5 grados)\n","        image_files = []\n","        for angle in range(0, 360, 5):\n","            filename = f\"obj{obj_id}_{angle}.png\"\n","            src_path = os.path.join(EXTRACT_FOLDER, filename)\n","            if os.path.exists(src_path):\n","                image_files.append(filename)\n","        \n","        # Mezclar aleatoriamente para garantizar un split justo\n","        random.seed(42)  # Semilla fija para reproducibilidad total\n","        random.shuffle(image_files)\n","        \n","        split_idx = int(len(image_files) * TRAIN_RATIO)\n","        train_files = image_files[:split_idx]\n","        test_files = image_files[split_idx:]\n","        \n","        # Copiar archivos a sus respectivas carpetas\n","        for img in train_files:\n","            shutil.copy(os.path.join(EXTRACT_FOLDER, img), os.path.join(train_dir, class_name, img))\n","        for img in test_files:\n","            shutil.copy(os.path.join(EXTRACT_FOLDER, img), os.path.join(test_dir, class_name, img))\n","            \n","        print(f\"  ➔ {class_name}: {len(train_files)} train, {len(test_files)} test\")\n","\n","    # Generar README.md automático para documentar el experimento\n","    readme_path = os.path.join(TARGET_DIR, \"README.md\")\n","    with open(readme_path, \"w\", encoding=\"utf-8\") as f:\n","        f.write(\"# Dataset COIL-100 Subconjunto - Proyecto 1\\n\\n\")\n","        f.write(\"Dataset preparado para la comparación de pipelines de visión clásica vs. CNN.\\n\\n\")\n","        f.write(\"## Clases seleccionadas:\\n\")\n","        f.write(\"- **clase_1**: Objeto 1 (ej. lata/botella)\\n\")\n","        f.write(\"- **clase_5**: Objeto 5 (ej. juguete)\\n\")\n","        f.write(\"- **clase_12**: Objeto 12 (ej. herramienta)\\n\")\n","        f.write(\"- **clase_25**: Objeto 25 (ej. fruta/objeto redondo)\\n\")\n","        f.write(\"- **clase_40**: Objeto 40 (ej. pieza industrial)\\n\\n\")\n","        f.write(f\"## División de datos:\\n- Entrenamiento: {int(TRAIN_RATIO*100)}%\\n- Prueba: {int((1-TRAIN_RATIO)*100)}%\\n\")\n","        f.write(\"- Aleatorización con semilla fija (42) para reproducibilidad.\\n\")\n","        \n","    print(\"✅ Organización completada. Revisa la carpeta 'data/' y su 'README.md'.\")\n","\n","if __name__ == \"__main__\":\n","    if download_dataset():\n","        extract_dataset()\n","        organize_dataset()\n","        print(\"\\n🚀 ¡Listo! El dataset está preparado para el pipeline.\")"]},{"cell_type":"code","execution_count":null,"id":"c109111d","metadata":{"papermill":{"duration":0.001311,"end_time":"2026-10-20T19:11:45.713509+00:00","exception":false,"start_time":"2026-10-20T19:11:45.712198+00:00","status":"completed"},"tags":[]},"outputs":[],"source":[]}],"metadata":{"kaggle":{"ac